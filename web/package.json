  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
